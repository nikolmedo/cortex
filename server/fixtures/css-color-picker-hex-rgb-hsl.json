  "applet": {
    "title": "CSS colour picker",
    "html": "<style>\n  .cp { display: grid; gap: 20px; max-width: 820px; margin: 0 auto; }\n  .cp-top { display: grid; gap: 16px; grid-template-columns: minmax(0, 1fr); }\n  @media (min-width: 560px) { .cp-top { grid-template-columns: 168px minmax(0, 1fr); } }\n  .cp-swatch {\n    position: relative; min-height: 132px; border: 1px solid var(--line-strong);\n    background-color: #d8e4ea;\n    background-image: linear-gradient(45deg, #8a959c 25%, transparent 25%, transparent 75%, #8a959c 75%),\n      linear-gradient(45deg, #8a959c 25%, transparent 25%, transparent 75%, #8a959c 75%);\n    background-size: 16px 16px; background-position: 0 0, 8px 8px;\n  }\n  .cp-swatch > span { position: absolute; inset: 0; }\n  .cp-label {\n    font: 600 11px/1.2 var(--font-mono); text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-dim);\n  }\n  .cp-controls { display: grid; gap: 14px; }\n  .cp-row { display: grid; grid-template-columns: 92px minmax(0, 1fr) 52px; align-items: center; gap: 10px; }\n  .cp-row output { font: 13px/1 var(--font-mono); color: var(--text-hi); text-align: right; font-variant-numeric: tabular-nums; }\n  .cp input[type='range'] {\n    -webkit-appearance: none; appearance: none; width: 100%; height: 16px; margin: 0;\n    border: 1px solid var(--line-strong); background: var(--track, var(--surface)); cursor: pointer;\n  }\n  .cp input[type='range']::-webkit-slider-thumb {\n    -webkit-appearance: none; appearance: none; width: 10px; height: 24px; border-radius: 0;\n    background: var(--paper); border: 1px solid var(--paper-ink);\n  }\n  .cp input[type='range']::-moz-range-thumb {\n    width: 10px; height: 24px; border-radius: 0; background: var(--paper); border: 1px solid var(--paper-ink);\n  }\n  .cp input[type='text'] {\n    width: 100%; min-width: 0; padding: 9px 10px; border: 1px solid var(--line-strong); border-radius: 0;\n    background: var(--surface); color: var(--text-hi); font: 14px/1.2 var(--font-mono);\n  }\n  .cp input[type='text'][aria-invalid='true'] { border-color: var(--danger); }\n  .cp-hex { display: grid; grid-template-columns: 92px minmax(0, 1fr); align-items: center; gap: 10px; }\n  .cp-hint { grid-column: 2; min-height: 1.3em; margin: 0; font: 12px/1.3 var(--font-mono); color: var(--text-dim); }\n  .cp-hint[data-state='error'] { color: var(--danger); }\n  .cp-outputs { display: grid; gap: 10px; padding-top: 16px; border-top: 1px solid var(--line); }\n  .cp-out { display: grid; grid-template-columns: 92px minmax(0, 1fr) auto; align-items: center; gap: 10px; }\n  @media (max-width: 420px) {\n    .cp-row, .cp-hex, .cp-out { grid-template-columns: minmax(0, 1fr) auto; }\n    .cp-row .cp-label, .cp-hex .cp-label, .cp-out .cp-label { grid-column: 1 / -1; }\n    .cp-row output { grid-column: 2; grid-row: 2; }\n    .cp-hint { grid-column: 1 / -1; }\n  }\n  .cp button {\n    min-height: 38px; padding: 0 14px; border: 1px solid var(--line-strong); border-radius: 0;\n    background: var(--surface); color: var(--text-hi); cursor: pointer;\n    font: 600 11px/1 var(--font-mono); text-transform: uppercase; letter-spacing: 0.08em;\n  }\n  .cp button:hover { background: var(--raised); border-color: var(--signal); }\n  .cp-status { min-height: 1.3em; margin: 0; font: 12px/1.3 var(--font-mono); color: var(--ok); }\n</style>\n\n<div class=\"cp\">\n  <div class=\"cp-top\">\n    <div class=\"cp-swatch\" role=\"img\" id=\"cp-swatch\" aria-label=\"Selected colour\"><span id=\"cp-preview\"></span></div>\n    <div class=\"cp-controls\">\n      <div class=\"cp-row\">\n        <label class=\"cp-label\" for=\"cp-h\">Hue</label>\n        <input id=\"cp-h\" type=\"range\" min=\"0\" max=\"360\" step=\"1\">\n        <output id=\"cp-h-out\" for=\"cp-h\"></output>\n      </div>\n      <div class=\"cp-row\">\n        <label class=\"cp-label\" for=\"cp-s\">Saturation</label>\n        <input id=\"cp-s\" type=\"range\" min=\"0\" max=\"100\" step=\"1\">\n        <output id=\"cp-s-out\" for=\"cp-s\"></output>\n      </div>\n      <div class=\"cp-row\">\n        <label class=\"cp-label\" for=\"cp-l\">Lightness</label>\n        <input id=\"cp-l\" type=\"range\" min=\"0\" max=\"100\" step=\"1\">\n        <output id=\"cp-l-out\" for=\"cp-l\"></output>\n      </div>\n      <div class=\"cp-row\">\n        <label class=\"cp-label\" for=\"cp-a\">Alpha</label>\n        <input id=\"cp-a\" type=\"range\" min=\"0\" max=\"100\" step=\"1\">\n        <output id=\"cp-a-out\" for=\"cp-a\"></output>\n      </div>\n      <div class=\"cp-hex\">\n        <label class=\"cp-label\" for=\"cp-hex\">Hex</label>\n        <input id=\"cp-hex\" type=\"text\" inputmode=\"text\" spellcheck=\"false\" autocomplete=\"off\" maxlength=\"9\" aria-describedby=\"cp-hex-hint\">\n        <p class=\"cp-hint\" id=\"cp-hex-hint\" aria-live=\"polite\">3, 4, 6 or 8 digits, with or without #</p>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"cp-outputs\" role=\"group\" aria-label=\"CSS values\">\n    <div class=\"cp-out\">\n      <label class=\"cp-label\" for=\"cp-o-hex\">Hex</label>\n      <input id=\"cp-o-hex\" type=\"text\" readonly>\n      <button type=\"button\" data-copy=\"cp-o-hex\">Copy</button>\n    </div>\n    <div class=\"cp-out\">\n      <label class=\"cp-label\" for=\"cp-o-rgb\">rgb()</label>\n      <input id=\"cp-o-rgb\" type=\"text\" readonly>\n      <button type=\"button\" data-copy=\"cp-o-rgb\">Copy</button>\n    </div>\n    <div class=\"cp-out\">\n      <label class=\"cp-label\" for=\"cp-o-hsl\">hsl()</label>\n      <input id=\"cp-o-hsl\" type=\"text\" readonly>\n      <button type=\"button\" data-copy=\"cp-o-hsl\">Copy</button>\n    </div>\n    <div class=\"cp-out\">\n      <label class=\"cp-label\" for=\"cp-o-var\">Custom property</label>\n      <input id=\"cp-o-var\" type=\"text\" readonly>\n      <button type=\"button\" data-copy=\"cp-o-var\">Copy</button>\n    </div>\n    <p class=\"cp-status\" id=\"cp-status\" aria-live=\"polite\"></p>\n  </div>\n</div>\n\n<script>\n(() => {\n  const $ = id => document.getElementById(id);\n  const sliders = { h: $('cp-h'), s: $('cp-s'), l: $('cp-l'), a: $('cp-a') };\n  const hexInput = $('cp-hex');\n  const hint = $('cp-hex-hint');\n  const status = $('cp-status');\n  const HINT = hint.textContent;\n\n  // rgb is the source of truth; h/s/l are what the sliders show.\n  const state = { r: 111, g: 195, b: 255, a: 1, h: 0, s: 0, l: 0 };\n\n  const clamp = (v, lo, hi) => Math.min(hi, Math.max(lo, v));\n  const round = (v, d = 0) => Number(v.toFixed(d));\n  const hex2 = n => Math.round(n).toString(16).padStart(2, '0');\n\n  function hslToRgb(h, s, l) {\n    s /= 100; l /= 100;\n    const k = n => (n + h / 30) % 12;\n    const a = s * Math.min(l, 1 - l);\n    const f = n => l - a * Math.max(-1, Math.min(k(n) - 3, Math.min(9 - k(n), 1)));\n    return [f(0) * 255, f(8) * 255, f(4) * 255].map(Math.round);\n  }\n\n  function rgbToHsl(r, g, b) {\n    r /= 255; g /= 255; b /= 255;\n    const max = Math.max(r, g, b), min = Math.min(r, g, b);\n    const l = (max + min) / 2;\n    const d = max - min;\n    if (d === 0) return [0, 0, l * 100];\n    const s = d / (1 - Math.abs(2 * l - 1));\n    let h = max === r ? ((g - b) / d) % 6 : max === g ? (b - r) / d + 2 : (r - g) / d + 4;\n    h = (h * 60 + 360) % 360;\n    return [h, s * 100, l * 100];\n  }\n\n  function parseHex(text) {\n    const raw = text.trim().replace(/^#/, '');\n    if (!/^([0-9a-f]{3}|[0-9a-f]{4}|[0-9a-f]{6}|[0-9a-f]{8})$/i.test(raw)) return null;\n    const full = raw.length <= 4 ? raw.split('').map(c => c + c).join('') : raw;\n    const n = i => parseInt(full.slice(i, i + 2), 16);\n    return { r: n(0), g: n(2), b: n(4), a: full.length === 8 ? round(n(6) / 255, 2) : 1 };\n  }\n\n  function fromRgb(r, g, b, a) {\n    Object.assign(state, { r, g, b, a });\n    const [h, s, l] = rgbToHsl(r, g, b);\n    Object.assign(state, { h: round(h), s: round(s), l: round(l) });\n  }\n\n  function fromSliders() {\n    const h = Number(sliders.h.value), s = Number(sliders.s.value), l = Number(sliders.l.value);\n    const [r, g, b] = hslToRgb(h, s, l);\n    Object.assign(state, { r, g, b, h, s, l, a: Number(sliders.a.value) / 100 });\n  }\n\n  function formats() {\n    const { r, g, b, a, h, s, l } = state;\n    const alpha = round(a, 2);\n    const hex = `#${hex2(r)}${hex2(g)}${hex2(b)}${alpha < 1 ? hex2(alpha * 255) : ''}`;\n    return {\n      hex,\n      rgb: alpha < 1 ? `rgba(${r}, ${g}, ${b}, ${alpha})` : `rgb(${r}, ${g}, ${b})`,\n      hsl: alpha < 1 ? `hsla(${h}, ${s}%, ${l}%, ${alpha})` : `hsl(${h}, ${s}%, ${l}%)`,\n      prop: `--color-picked: ${hex};`,\n    };\n  }\n\n  function render(skipHexField) {\n    const { h, s, l, a } = state;\n    sliders.h.value = h; sliders.s.value = s; sliders.l.value = l; sliders.a.value = Math.round(a * 100);\n    $('cp-h-out').textContent = `${h}°`;\n    $('cp-s-out').textContent = `${s}%`;\n    $('cp-l-out').textContent = `${l}%`;\n    $('cp-a-out').textContent = `${Math.round(a * 100)}%`;\n\n    const f = formats();\n    $('cp-preview').style.background = f.rgb;\n    $('cp-swatch').setAttribute('aria-label', `Selected colour ${f.hex}`);\n    sliders.h.style.setProperty('--track', 'linear-gradient(90deg, hsl(0 100% 50%), hsl(60 100% 50%), hsl(120 100% 50%), hsl(180 100% 50%), hsl(240 100% 50%), hsl(300 100% 50%), hsl(360 100% 50%))');\n    sliders.s.style.setProperty('--track', `linear-gradient(90deg, hsl(${h} 0% ${l}%), hsl(${h} 100% ${l}%))`);\n    sliders.l.style.setProperty('--track', `linear-gradient(90deg, hsl(${h} ${s}% 0%), hsl(${h} ${s}% 50%), hsl(${h} ${s}% 100%))`);\n    sliders.a.style.setProperty('--track', `linear-gradient(90deg, rgb(${state.r} ${state.g} ${state.b} / 0), rgb(${state.r} ${state.g} ${state.b}))`);\n\n    if (!skipHexField) hexInput.value = f.hex;\n    $('cp-o-hex').value = f.hex;\n    $('cp-o-rgb').value = f.rgb;\n    $('cp-o-hsl').value = f.hsl;\n    $('cp-o-var').value = f.prop;\n  }\n\n  function setHint(text, error) {\n    hint.textContent = text;\n    hint.dataset.state = error ? 'error' : '';\n    hexInput.setAttribute('aria-invalid', error ? 'true' : 'false');\n  }\n\n  Object.values(sliders).forEach(input => input.addEventListener('input', () => {\n    fromSliders();\n    setHint(HINT, false);\n    render(false);\n  }));\n\n  hexInput.addEventListener('input', () => {\n    const parsed = parseHex(hexInput.value);\n    if (!parsed) {\n      setHint('Not a valid hex colour yet', true);\n      return;\n    }\n    setHint(HINT, false);\n    fromRgb(parsed.r, parsed.g, parsed.b, parsed.a);\n    render(true);\n  });\n\n  hexInput.addEventListener('blur', () => {\n    setHint(HINT, false);\n    render(false);\n  });\n\n  function copied(name) {\n    status.textContent = `Copied ${name}`;\n  }\n\n  function fallbackCopy(field, name) {\n    field.focus();\n    field.select();\n    let ok = false;\n    try { ok = document.execCommand('copy'); } catch (e) { ok = false; }\n    status.textContent = ok ? `Copied ${name}` : 'Selected: press Ctrl+C or Cmd+C to copy';\n  }\n\n  document.querySelectorAll('[data-copy]').forEach(button => button.addEventListener('click', () => {\n    const field = $(button.dataset.copy);\n    const name = button.parentElement.querySelector('label').textContent;\n    const text = field.value;\n    if (navigator.clipboard && navigator.clipboard.writeText) {\n      navigator.clipboard.writeText(text).then(() => copied(name), () => fallbackCopy(field, name));\n    } else {\n      fallbackCopy(field, name);\n    }\n  }));\n\n  try {\n    fromRgb(state.r, state.g, state.b, state.a);\n    render(false);\n  } catch (err) {\n    status.textContent = 'The picker could not start.';\n  }\n})();\n</script>"
  },

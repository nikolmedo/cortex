    "html": "<style>\n  .bs-container {\n    max-width: 800px;\n    margin: 0 auto;\n    display: flex;\n    flex-direction: column;\n    gap: 20px;\n    color: var(--text);\n    font-family: var(--font-body);\n  }\n\n  .bs-header {\n    display: flex;\n    flex-wrap: wrap;\n    justify-content: space-between;\n    align-items: flex-end;\n    gap: 12px;\n    border-bottom: 1px solid var(--line);\n    padding-bottom: 14px;\n  }\n\n  .bs-title-group h2 {\n    margin: 0 0 4px 0;\n    font-size: 1.15rem;\n    font-weight: 600;\n    color: var(--text-hi);\n  }\n\n  .bs-title-group p {\n    margin: 0;\n    font-size: 0.85rem;\n    color: var(--text-dim);\n  }\n\n  .bs-controls {\n    display: flex;\n    flex-wrap: wrap;\n    align-items: center;\n    gap: 8px;\n  }\n\n  .bs-input-group {\n    display: flex;\n    align-items: center;\n    background: var(--surface);\n    border: 1px solid var(--line);\n    padding: 2px 8px;\n  }\n\n  .bs-input-group label {\n    font-family: var(--font-mono);\n    font-size: 0.75rem;\n    text-transform: uppercase;\n    color: var(--text-dim);\n    margin-right: 6px;\n  }\n\n  .bs-input-group input {\n    background: transparent;\n    border: none;\n    color: var(--text-hi);\n    font-family: var(--font-mono);\n    font-size: 0.95rem;\n    width: 60px;\n    outline: none;\n  }\n\n  .bs-btn {\n    background: var(--surface);\n    color: var(--text);\n    border: 1px solid var(--line);\n    padding: 7px 14px;\n    font-family: var(--font-mono);\n    font-size: 0.75rem;\n    text-transform: uppercase;\n    letter-spacing: 0.05em;\n    cursor: pointer;\n    border-radius: 0;\n    transition: background 0.1s, border-color 0.1s, color 0.1s;\n  }\n\n  .bs-btn:hover:not(:disabled) {\n    background: var(--raised);\n    color: var(--text-hi);\n    border-color: var(--line-strong);\n  }\n\n  .bs-btn:disabled {\n    opacity: 0.4;\n    cursor: not-allowed;\n  }\n\n  .bs-btn.primary {\n    border-color: var(--signal);\n    color: var(--signal);\n  }\n\n  .bs-btn.primary:hover:not(:disabled) {\n    background: var(--signal);\n    color: var(--paper-ink);\n  }\n\n  /* Array visualizer */\n  .bs-board-wrap {\n    overflow-x: auto;\n    padding: 12px 2px 24px 2px;\n    -webkit-overflow-scrolling: touch;\n  }\n\n  .bs-board {\n    display: flex;\n    min-width: 100%;\n    width: max-content;\n    gap: 6px;\n    justify-content: flex-start;\n  }\n\n  .bs-cell-col {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    width: 44px;\n    flex-shrink: 0;\n    position: relative;\n  }\n\n  .bs-tag-slot {\n    height: 20px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-family: var(--font-mono);\n    font-size: 0.65rem;\n    font-weight: 700;\n    letter-spacing: 0.05em;\n  }\n\n  .bs-tag-slot.top {\n    margin-bottom: 4px;\n  }\n\n  .bs-tag-slot.bottom {\n    margin-top: 4px;\n    height: 18px;\n    color: var(--text-dim);\n  }\n\n  .bs-cell {\n    width: 44px;\n    height: 48px;\n    background: var(--surface);\n    border: 1px solid var(--line);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-family: var(--font-mono);\n    font-size: 1.05rem;\n    font-weight: 600;\n    color: var(--text-hi);\n    transition: all 0.15s ease;\n    user-select: none;\n  }\n\n  .bs-cell-col.eliminated .bs-cell {\n    opacity: 0.25;\n    background: transparent;\n    border-style: dashed;\n    color: var(--text-dim);\n  }\n\n  .bs-cell-col.in-range .bs-cell {\n    border-color: var(--line-strong);\n    background: var(--surface);\n  }\n\n  .bs-cell-col.is-mid .bs-cell {\n    border-color: var(--signal);\n    border-width: 2px;\n    color: var(--signal);\n    background: var(--raised);\n  }\n\n  .bs-cell-col.found .bs-cell {\n    border-color: var(--ok);\n    background: var(--ok);\n    color: var(--bg);\n  }\n\n  .pointer-pill {\n    padding: 1px 4px;\n    font-size: 0.65rem;\n    text-transform: uppercase;\n    line-height: 1;\n    border-radius: 0;\n  }\n\n  .ptr-l { background: var(--raised); border: 1px solid var(--line-strong); color: var(--text-hi); }\n  .ptr-m { background: var(--signal); color: var(--paper-ink); }\n  .ptr-h { background: var(--raised); border: 1px solid var(--line-strong); color: var(--text-hi); }\n\n  /* Info panel */\n  .bs-status-card {\n    background: var(--surface);\n    border: 1px solid var(--line);\n    padding: 16px;\n    display: flex;\n    flex-direction: column;\n    gap: 12px;\n  }\n\n  .bs-metrics {\n    display: grid;\n    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));\n    gap: 10px;\n    border-bottom: 1px solid var(--line);\n    padding-bottom: 12px;\n  }\n\n  .bs-metric-item {\n    display: flex;\n    flex-direction: column;\n    gap: 2px;\n  }\n\n  .bs-metric-label {\n    font-family: var(--font-mono);\n    font-size: 0.65rem;\n    text-transform: uppercase;\n    color: var(--text-dim);\n    letter-spacing: 0.05em;\n  }\n\n  .bs-metric-value {\n    font-family: var(--font-mono);\n    font-size: 1rem;\n    font-weight: 600;\n    color: var(--text-hi);\n  }\n\n  .bs-narrative {\n    font-size: 0.9rem;\n    line-height: 1.5;\n    color: var(--text);\n  }\n\n  .bs-narrative strong {\n    color: var(--text-hi);\n  }\n\n  .bs-narrative .highlight {\n    font-family: var(--font-mono);\n    padding: 1px 4px;\n    background: var(--raised);\n    border: 1px solid var(--line);\n  }\n\n  .bs-presets {\n    display: flex;\n    align-items: center;\n    gap: 6px;\n    flex-wrap: wrap;\n    font-size: 0.8rem;\n  }\n\n  .bs-presets span {\n    font-family: var(--font-mono);\n    font-size: 0.7rem;\n    color: var(--text-dim);\n    text-transform: uppercase;\n  }\n\n  .bs-preset-btn {\n    background: transparent;\n    border: 1px solid var(--line);\n    color: var(--text-dim);\n    font-family: var(--font-mono);\n    font-size: 0.75rem;\n    padding: 3px 8px;\n    cursor: pointer;\n  }\n\n  .bs-preset-btn:hover {\n    color: var(--text-hi);\n    border-color: var(--line-strong);\n  }\n</style>\n\n<div class=\"bs-container\">\n  <div class=\"bs-header\">\n    <div class=\"bs-title-group\">\n      <h2>Binary Search Stepper</h2>\n      <p>Repeatedly halving a sorted space in O(log n) time</p>\n    </div>\n\n    <div class=\"bs-controls\">\n      <div class=\"bs-input-group\">\n        <label for=\"bs-target\">Target</label>\n        <input type=\"number\" id=\"bs-target\" value=\"38\" min=\"0\" max=\"999\" />\n      </div>\n      <button class=\"bs-btn\" id=\"bs-btn-prev\" title=\"Step Back\">&larr; Back</button>\n      <button class=\"bs-btn primary\" id=\"bs-btn-next\" title=\"Next Step\">Step &rarr;</button>\n      <button class=\"bs-btn\" id=\"bs-btn-reset\" title=\"Reset to start\">Reset</button>\n    </div>\n  </div>\n\n  <div class=\"bs-board-wrap\" tabindex=\"0\" aria-label=\"Visual array grid\">\n    <div class=\"bs-board\" id=\"bs-board\"></div>\n  </div>\n\n  <div class=\"bs-status-card\">\n    <div class=\"bs-metrics\">\n      <div class=\"bs-metric-item\">\n        <span class=\"bs-metric-label\">Step / Comparisons</span>\n        <span class=\"bs-metric-value\" id=\"m-step\">0 / 0</span>\n      </div>\n      <div class=\"bs-metric-item\">\n        <span class=\"bs-metric-label\">Search Range [L, H]</span>\n        <span class=\"bs-metric-value\" id=\"m-range\">[0, 15]</span>\n      </div>\n      <div class=\"bs-metric-item\">\n        <span class=\"bs-metric-label\">Mid Index &amp; Val</span>\n        <span class=\"bs-metric-value\" id=\"m-mid\">&mdash;</span>\n      </div>\n      <div class=\"bs-metric-item\">\n        <span class=\"bs-metric-label\">Status</span>\n        <span class=\"bs-metric-value\" id=\"m-status\">Ready</span>\n      </div>\n    </div>\n\n    <div class=\"bs-narrative\" id=\"bs-explanation\" aria-live=\"polite\">\n      Initial state. Click <strong>Step &rarr;</strong> to compute the midpoint and compare against target.\n    </div>\n\n    <div class=\"bs-presets\">\n      <span>Try target:</span>\n      <button class=\"bs-preset-btn\" data-val=\"12\">12 (Left side)</button>\n      <button class=\"bs-preset-btn\" data-val=\"38\">38 (Right side)</button>\n      <button class=\"bs-preset-btn\" data-val=\"4\">4 (First element)</button>\n      <button class=\"bs-preset-btn\" data-val=\"91\">91 (Last element)</button>\n      <button class=\"bs-preset-btn\" data-val=\"25\">25 (Missing value)</button>\n    </div>\n  </div>\n</div>\n\n<script>\n{\n  const ARR = [4, 7, 12, 16, 21, 28, 33, 38, 45, 52, 60, 69, 74, 82, 88, 91];\n  \n  let target = 38;\n  let steps = [];\n  let currentStepIdx = 0;\n\n  const boardEl = document.getElementById('bs-board');\n  const targetInput = document.getElementById('bs-target');\n  const btnPrev = document.getElementById('bs-btn-prev');\n  const btnNext = document.getElementById('bs-btn-next');\n  const btnReset = document.getElementById('bs-btn-reset');\n  const metricStep = document.getElementById('m-step');\n  const metricRange = document.getElementById('m-range');\n  const metricMid = document.getElementById('m-mid');\n  const metricStatus = document.getElementById('m-status');\n  const explanationEl = document.getElementById('bs-explanation');\n\n  function precomputeSteps(arr, key) {\n    const sequence = [];\n    let L = 0;\n    let H = arr.length - 1;\n    let stepCount = 0;\n\n    // Initial state before inspecting anything\n    sequence.push({\n      L, H,\n      mid: null,\n      found: false,\n      exhausted: false,\n      stepCount: 0,\n      text: `Start binary search on array of length ${arr.length}. Looking for target <span class=\"highlight\">${key}</span>. Initial active boundary is from index 0 to ${H}.`\n    });\n\n    while (L <= H) {\n      stepCount++;\n      const mid = Math.floor((L + H) / 2);\n      const midVal = arr[mid];\n\n      if (midVal === key) {\n        sequence.push({\n          L, H, mid,\n          found: true,\n          exhausted: false,\n          stepCount,\n          text: `Midpoint at index <strong>${mid}</strong> has value <strong>${midVal}</strong>. Value matches target <span class=\"highlight\">${key}</span>! Target found in ${stepCount} ${stepCount === 1 ? 'step' : 'steps'}.`\n        });\n        return sequence;\n      } else if (midVal < key) {\n        sequence.push({\n          L, H, mid,\n          found: false,\n          exhausted: false,\n          stepCount,\n          text: `Check midpoint at index <strong>${mid}</strong> (value: <strong>${midVal}</strong>). Since ${midVal} &lt; ${key}, target must lie in the right half. Discarding indices [${L}..${mid}]. Updating low to ${mid + 1}.`\n        });\n        L = mid + 1;\n      } else {\n        sequence.push({\n          L, H, mid,\n          found: false,\n          exhausted: false,\n          stepCount,\n          text: `Check midpoint at index <strong>${mid}</strong> (value: <strong>${midVal}</strong>). Since ${midVal} &gt; ${key}, target must lie in the left half. Discarding indices [${mid}..${H}]. Updating high to ${mid - 1}.`\n        });\n        H = mid - 1;\n      }\n    }\n\n    sequence.push({\n      L, H,\n      mid: null,\n      found: false,\n      exhausted: true,\n      stepCount,\n      text: `Search range exhausted (low=${L} &gt; high=${H}). Target <span class=\"highlight\">${key}</span> does not exist in the array.`\n    });\n\n    return sequence;\n  }\n\n  function renderBoard() {\n    boardEl.innerHTML = '';\n    const state = steps[currentStepIdx];\n\n    ARR.forEach((val, idx) => {\n      const col = document.createElement('div');\n      col.className = 'bs-cell-col';\n\n      const inRange = idx >= state.L && idx <= state.H;\n      const isMid = (idx === state.mid);\n      const isFound = state.found && isMid;\n\n      if (!inRange && (state.mid === null || idx !== state.mid)) {\n        col.classList.add('eliminated');\n      } else if (inRange) {\n        col.classList.add('in-range');\n      }\n\n      if (isMid) col.classList.add('is-mid');\n      if (isFound) col.classList.add('found');\n\n      // Top Tag: Low, Mid, High indicators\n      const topTag = document.createElement('div');\n      topTag.className = 'bs-tag-slot top';\n\n      let tags = [];\n      if (idx === state.L && state.L <= state.H) tags.push('<span class=\"pointer-pill ptr-l\">L</span>');\n      if (idx === state.mid) tags.push('<span class=\"pointer-pill ptr-m\">M</span>');\n      if (idx === state.H && state.L <= state.H) tags.push('<span class=\"pointer-pill ptr-h\">H</span>');\n\n      topTag.innerHTML = tags.join('');\n\n      // Cell\n      const cell = document.createElement('div');\n      cell.className = 'bs-cell';\n      cell.textContent = val;\n\n      // Bottom Tag: Array index\n      const bottomTag = document.createElement('div');\n      bottomTag.className = 'bs-tag-slot bottom';\n      bottomTag.textContent = idx;\n\n      col.appendChild(topTag);\n      col.appendChild(cell);\n      col.appendChild(bottomTag);\n      boardEl.appendChild(col);\n    });\n  }\n\n  function update() {\n    const state = steps[currentStepIdx];\n    renderBoard();\n\n    metricStep.textContent = `${currentStepIdx} / ${steps.length - 1}`;\n    \n    if (state.L <= state.H) {\n      metricRange.textContent = `[${state.L}, ${state.H}] (${state.H - state.L + 1} items)`;\n    } else {\n      metricRange.textContent = 'None (Empty)';\n    }\n\n    if (state.mid !== null) {\n      metricMid.textContent = `i=${state.mid} (val: ${ARR[state.mid]})`;\n    } else {\n      metricMid.textContent = '\\u2014';\n    }\n\n    if (state.found) {\n      metricStatus.textContent = 'Found';\n      metricStatus.style.color = 'var(--ok)';\n    } else if (state.exhausted) {\n      metricStatus.textContent = 'Not Found';\n      metricStatus.style.color = 'var(--danger)';\n    } else if (currentStepIdx === 0) {\n      metricStatus.textContent = 'Ready';\n      metricStatus.style.color = 'var(--text-dim)';\n    } else {\n      metricStatus.textContent = 'Searching...';\n      metricStatus.style.color = 'var(--signal)';\n    }\n\n    explanationEl.innerHTML = state.text;\n\n    btnPrev.disabled = currentStepIdx === 0;\n    btnNext.disabled = currentStepIdx === steps.length - 1;\n  }\n\n  function init(newTarget) {\n    target = Number(newTarget);\n    targetInput.value = target;\n    steps = precomputeSteps(ARR, target);\n    currentStepIdx = 0;\n    update();\n  }\n\n  btnNext.addEventListener('click', () => {\n    if (currentStepIdx < steps.length - 1) {\n      currentStepIdx++;\n      update();\n    }\n  });\n\n  btnPrev.addEventListener('click', () => {\n    if (currentStepIdx > 0) {\n      currentStepIdx--;\n      update();\n    }\n  });\n\n  btnReset.addEventListener('click', () => {\n    currentStepIdx = 0;\n    update();\n  });\n\n  targetInput.addEventListener('change', () => {\n    const val = parseInt(targetInput.value, 10);\n    init(isNaN(val) ? 0 : val);\n  });\n\n  document.querySelectorAll('.bs-preset-btn').forEach(btn => {\n    btn.addEventListener('click', (e) => {\n      init(e.currentTarget.getAttribute('data-val'));\n    });\n  });\n\n  // Keyboard navigation support\n  boardEl.addEventListener('keydown', (e) => {\n    if (e.key === 'ArrowRight' || e.key === ' ') {\n      e.preventDefault();\n      btnNext.click();\n    } else if (e.key === 'ArrowLeft') {\n      e.preventDefault();\n      btnPrev.click();\n    }\n  });\n\n  init(38);\n}\n</script>"
  }
}
